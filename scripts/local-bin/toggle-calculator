#!/usr/bin/env python3
import json
import os
import subprocess
import sys

def main():
    try:
        res = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, check=True)
        clients = json.loads(res.stdout)
    except Exception:
        clients = []

    calc_client = None
    for c in clients:
        if c.get("class") == "omacalc" or c.get("initialClass") == "omacalc":
            calc_client = c
            break

    if calc_client:
        # Check active workspace
        try:
            ws_res = subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True, check=True)
            active_ws = json.loads(ws_res.stdout).get("id")
        except Exception:
            active_ws = None

        calc_ws = calc_client.get("workspace", {}).get("id")
        addr = calc_client.get("address", "")

        if active_ws is not None and calc_ws != active_ws:
            # Move to current workspace and focus
            subprocess.run(["hyprctl", "dispatch", "movetoworkspace", f"{active_ws},address:{addr}"], capture_output=True)
            subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"], capture_output=True)
        else:
            # It's already on current workspace -> dismiss/close it
            subprocess.run(["pkill", "-x", "omacalc"])
    else:
        # Launch omacalc
        subprocess.Popen(["omacalc"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

if __name__ == "__main__":
    main()
