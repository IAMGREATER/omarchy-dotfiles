    # -----------------------------------------------------------------------
    def on_save_credentials(self, btn):
        username = self.creds_username_row.get_text().strip()
        token    = self.creds_token_row.get_text().strip()

        if not username or not token:
            self.creds_status_label.set_text("⚠️ Please enter both a username and a token.")
            return

        ok_u = keyring_store(KEYRING_ATTR_USERNAME, username)
        ok_t = keyring_store(KEYRING_ATTR_TOKEN, token)

        if ok_u and ok_t:
            ensure_git_credential_helper(self.repo_dir)
            self.creds_status_label.set_text(
                "✅ Credentials saved to keyring. "
                "Git is now configured to use them automatically."
            )
            self.github_row.set_subtitle(f"Sync changes to {username}/omarchy-dotfiles")
        else:
            self.creds_status_label.set_text("❌ Failed to save to keyring. Is a keyring daemon running?")

    def on_clear_credentials(self, btn):
        keyring_clear(KEYRING_ATTR_USERNAME)
        keyring_clear(KEYRING_ATTR_TOKEN)
        self.creds_username_row.set_text("")
        self.creds_token_row.set_text("")
        self.creds_status_label.set_text("🗑️ Credentials cleared from keyring.")

    def on_test_github_connection(self, btn):
        username = self.creds_username_row.get_text().strip()
        token    = self.creds_token_row.get_text().strip()

        if not username or not token:
            self.creds_status_label.set_text("⚠️ Enter credentials first.")
            return

        self.creds_status_label.set_text("⏳ Testing connection…")

        def _test():
            try:
                result = subprocess.run(
                    ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}",
                     "-u", f"{username}:{token}",
                     "https://api.github.com/user"],
                    capture_output=True, text=True, timeout=15
                )
                code = result.stdout.strip()
                if code == "200":
                    GLib.idle_add(self.creds_status_label.set_text,
                                  f"✅ Connection successful! Authenticated as @{username}.")
                elif code == "401":
                    GLib.idle_add(self.creds_status_label.set_text,
                                  "❌ Authentication failed — check your token.")
                else:
                    GLib.idle_add(self.creds_status_label.set_text,
                                  f"⚠️ Unexpected response: HTTP {code}")
            except Exception as e:
                GLib.idle_add(self.creds_status_label.set_text, f"❌ Error: {e}")

        threading.Thread(target=_test, daemon=True).start()

