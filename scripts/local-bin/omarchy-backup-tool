# ---------------------------------------------------------------------------
# Keyring helpers
# ---------------------------------------------------------------------------
def keyring_store(attribute, value):
    proc = subprocess.Popen(
        ["secret-tool", "store", "--label", attribute, "application", attribute],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    proc.communicate(input=value.encode())
    return proc.returncode == 0


def keyring_get(attribute):
    try:
        result = subprocess.run(
            ["secret-tool", "lookup", "application", attribute],
            capture_output=True, text=True
        )
        return result.stdout.strip() if result.returncode == 0 else ""
    except Exception:
        return ""


def keyring_clear(attribute):
    subprocess.run(
        ["secret-tool", "clear", "application", attribute],
        capture_output=True
    )


def ensure_git_credential_helper(repo_dir):
    helper_path = os.path.expanduser("~/.local/bin/git-credential-omarchy")
    subprocess.run(
        ["git", "-C", repo_dir, "config", "credential.helper", helper_path],
        capture_output=True
    )


