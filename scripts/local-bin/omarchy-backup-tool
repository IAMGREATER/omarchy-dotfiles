class BackupApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.omarchy.BackupTool", flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = BackupWindow(application=self)
        win.present()

class BackupWindow(Adw.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.set_title("Omarchy Backup Hub")
        self.set_default_size(720, 780)

        self.switches = {}
        self.repo_dir = os.path.expanduser("~/omarchy-dotfiles")
        self.vault_dir = "/run/media/subi/VAULT"
        
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        # Header Bar
        header = Adw.HeaderBar()
        self.title_widget = Adw.WindowTitle(title="Omarchy Backup Hub", subtitle="Backup configs, plugins, and customisations")
        header.set_title_widget(self.title_widget)
        main_box.append(header)

        # Content in ScrolledWindow
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        main_box.append(scrolled)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(700)
        scrolled.set_child(clamp)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content_box.set_margin_top(16)
        content_box.set_margin_bottom(24)
        content_box.set_margin_start(16)
        content_box.set_margin_end(16)
        clamp.set_child(content_box)

        # Destinations Section
        dest_group = Adw.PreferencesGroup(title="Backup Destinations", description="Choose where your backup will be saved")
        content_box.append(dest_group)

        # GitHub Repo Row
        self.github_row = Adw.ActionRow(title="GitHub Repository", subtitle="Sync to IAMGREATER/omarchy-dotfiles")
        self.github_switch = Gtk.Switch()
        self.github_switch.set_active(True)
        self.github_switch.set_valign(Gtk.Align.CENTER)
        self.github_row.add_suffix(self.github_switch)
        self.github_row.set_activatable_widget(self.github_switch)
        dest_group.add(self.github_row)

        # Local / External Storage Row
        vault_connected = os.path.isdir(self.vault_dir)
        self.local_row = Adw.ActionRow(title="VAULT External Drive", subtitle="/run/media/subi/VAULT" if vault_connected else "Drive not currently connected")
        self.local_switch = Gtk.Switch()
        self.local_switch.set_active(vault_connected)
        self.local_switch.set_valign(Gtk.Align.CENTER)
        self.local_row.add_suffix(self.local_switch)
        self.local_row.set_activatable_widget(self.local_switch)
        dest_group.add(self.local_row)

        # Custom Folder Row
        self.custom_row = Adw.ActionRow(title="Custom Directory Backup", subtitle="Disabled")
        self.custom_switch = Gtk.Switch()
        self.custom_switch.set_active(False)
        self.custom_switch.set_valign(Gtk.Align.CENTER)
        self.custom_switch.connect("notify::active", self.on_custom_toggle)
        self.custom_row.add_suffix(self.custom_switch)

        self.custom_choose_btn = Gtk.Button(label="Choose Folder...")
        self.custom_choose_btn.set_valign(Gtk.Align.CENTER)
        self.custom_choose_btn.set_sensitive(False)
        self.custom_choose_btn.connect("clicked", self.on_choose_folder)
        self.custom_row.add_suffix(self.custom_choose_btn)
        self.custom_path = None

        dest_group.add(self.custom_row)

        # Items Section
        items_group = Adw.PreferencesGroup(title="Configuration & Items to Backup", description="Select which settings, configurations, and plugins to include")
        content_box.append(items_group)

        for cat in BACKUP_CATEGORIES:
            row = Adw.ActionRow(title=cat["title"], subtitle=cat["subtitle"])
            sw = Gtk.Switch()
            sw.set_active(cat.get("default", True))
            sw.set_valign(Gtk.Align.CENTER)
            row.add_suffix(sw)
            row.set_activatable_widget(sw)
            items_group.add(row)
            self.switches[cat["id"]] = sw

        # Progress / Log Box
        self.log_group = Adw.PreferencesGroup(title="Status & Activity")
        content_box.append(self.log_group)

        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_fraction(0.0)
        self.log_group.add(self.progress_bar)

        self.status_label = Gtk.Label(label="Ready to backup.")
        self.status_label.set_xalign(0.0)
        self.status_label.set_margin_top(8)
        self.log_group.add(self.status_label)

        # Bottom Actions Bar
        bottom_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        bottom_bar.set_margin_top(8)
        bottom_bar.set_margin_bottom(16)
        bottom_bar.set_margin_start(16)
        bottom_bar.set_margin_end(16)
        main_box.append(bottom_bar)

        self.select_all_btn = Gtk.Button(label="Select All")
        self.select_all_btn.connect("clicked", lambda b: self.set_all_switches(True))
        bottom_bar.append(self.select_all_btn)

        self.deselect_btn = Gtk.Button(label="Deselect All")
        self.deselect_btn.connect("clicked", lambda b: self.set_all_switches(False))
        bottom_bar.append(self.deselect_btn)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bottom_bar.append(spacer)

        self.backup_btn = Gtk.Button(label="Start Backup Now")
        self.backup_btn.add_css_class("suggested-action")
        self.backup_btn.connect("clicked", self.on_start_backup)
        bottom_bar.append(self.backup_btn)

    def set_all_switches(self, state):
        for sw in self.switches.values():
            sw.set_active(state)

    def on_custom_toggle(self, sw, param):
        active = sw.get_active()
        self.custom_choose_btn.set_sensitive(active)
        if not active:
            self.custom_row.set_subtitle("Disabled")
        elif self.custom_path:
            self.custom_row.set_subtitle(self.custom_path)
        else:
            self.custom_row.set_subtitle("Select a target directory...")

    def on_choose_folder(self, btn):
        dialog = Gtk.FileDialog()
        dialog.set_title("Select Backup Destination Folder")
        dialog.select_folder(self, None, self.on_folder_selected)

    def on_folder_selected(self, dialog, result):
        try:
            folder = dialog.select_folder_finish(result)
            if folder:
                self.custom_path = folder.get_path()
                self.custom_row.set_subtitle(self.custom_path)
        except Exception as e:
            pass

    def on_start_backup(self, btn):
        dest_gh = self.github_switch.get_active()
        dest_vault = self.local_switch.get_active() and os.path.isdir(self.vault_dir)
        dest_custom = self.custom_switch.get_active() and bool(self.custom_path)

        if not (dest_gh or dest_vault or dest_custom):
            self.status_label.set_text("⚠️ Please select at least one valid destination (GitHub, VAULT, or Custom folder).")
            return

        selected_items = [cid for cid, sw in self.switches.items() if sw.get_active()]
        if not selected_items:
            self.status_label.set_text("⚠️ Please select at least one item to backup.")
            return

        self.backup_btn.set_sensitive(False)
        self.progress_bar.set_fraction(0.05)
        self.status_label.set_text("Starting backup process...")

        thread = threading.Thread(target=self.run_backup, args=(dest_gh, dest_vault, dest_custom, selected_items))
        thread.daemon = True
        thread.start()

    def update_ui_status(self, text, frac):
        GLib.idle_add(self._apply_status, text, frac)

    def _apply_status(self, text, frac):
        self.status_label.set_text(text)
        self.progress_bar.set_fraction(frac)

    def finish_backup(self, success, msg):
        GLib.idle_add(self._apply_finish, success, msg)

    def _apply_finish(self, success, msg):
        self.backup_btn.set_sensitive(True)
        self.progress_bar.set_fraction(1.0 if success else 0.0)
        self.status_label.set_text(msg)

        # Notify desktop
        subprocess.run(["notify-send", "-a", "Backup Hub", "Backup Completed" if success else "Backup Failed", msg])

    def run_backup(self, dest_gh, dest_vault, dest_custom, selected_items):
        try:
            date_str = datetime.now().strftime("%d-%m-%Y")
            repo = self.repo_dir
            os.makedirs(repo, exist_ok=True)

            total_steps = len(selected_items) + 3
            cur_step = 0

            # 1. Sync chosen items to repo directory
            for cat in BACKUP_CATEGORIES:
                cid = cat["id"]
                if cid not in selected_items:
                    continue

                cur_step += 1
                self.update_ui_status(f"Backing up {cat['title']}...", cur_step / total_steps)

                if "source" in cat:
                    src = cat["source"]
                    dst = os.path.join(repo, cat["dest_sub"])
                    if os.path.exists(src):
                        os.makedirs(dst, exist_ok=True)
                        subprocess.run(["rsync", "-a", "--delete", f"{src}/", f"{dst}/"])

                elif "sources" in cat:
                    for src, sub in cat["sources"]:
                        if os.path.exists(src):
                            dst = os.path.join(repo, sub)
                            os.makedirs(dst, exist_ok=True)
                            subprocess.run(["rsync", "-a", "--delete", f"{src}/", f"{dst}/"])

                elif "files" in cat:
                    for fpath, sub in cat["files"]:
                        if os.path.exists(fpath):
                            dst_file = os.path.join(repo, sub)
                            os.makedirs(os.path.dirname(dst_file), exist_ok=True)
                            subprocess.run(["cp", fpath, dst_file])

                elif cat.get("generator"):
                    pkg_dir = os.path.join(repo, "packages")
                    os.makedirs(pkg_dir, exist_ok=True)
                    # Pacman explicit
                    with open(os.path.join(pkg_dir, "pacman-explicit.txt"), "w") as f:
                        subprocess.run(["pacman", "-Qe"], stdout=f)
                    # AUR
                    with open(os.path.join(pkg_dir, "aur-packages.txt"), "w") as f:
                        subprocess.run(["pacman", "-Qm"], stdout=f)
                    # Omarchy plugins
                    with open(os.path.join(pkg_dir, "omarchy-plugins.txt"), "w") as f:
                        subprocess.run(["omarchy", "plugin", "list"], stdout=f)
                    # Third-party enabled
                    res = subprocess.run(["omarchy", "plugin", "list"], capture_output=True, text=True)
                    third_party = []
                    for line in res.stdout.splitlines()[1:]:
                        parts = line.split()
                        if len(parts) >= 3 and parts[1] == "enabled" and parts[2] == "third-party":
                            third_party.append(parts[0])
                    with open(os.path.join(pkg_dir, "omarchy-third-party-enabled.txt"), "w") as f:
                        f.write("\n".join(third_party) + "\n")
                    # Mise tools
                    mise_cfg = os.path.expanduser("~/.config/mise/config.toml")
                    if os.path.isfile(mise_cfg):
                        subprocess.run(["cp", mise_cfg, os.path.join(pkg_dir, "mise-tools.toml")])

            # Clean any backup artifacts from local-bin in repo
            bin_target = os.path.join(repo, "scripts/local-bin")
            if os.path.isdir(bin_target):
                subprocess.run(["find", bin_target, "-name", "*.bak*", "-delete"])

            # 2. Push to GitHub if selected
            gh_msg = ""
            if dest_gh:
                cur_step += 1
                self.update_ui_status("Committing and pushing to GitHub...", cur_step / total_steps)
                subprocess.run(["git", "-C", repo, "add", "-A"])
                diff = subprocess.run(["git", "-C", repo, "diff", "--cached", "--quiet"])
                if diff.returncode != 0:
                    subprocess.run(["git", "-C", repo, "commit", "-m", f"Backup update {date_str}"])
                    push_res = subprocess.run(["git", "-C", repo, "push", "origin", "main"], capture_output=True, text=True)
                    if push_res.returncode == 0:
                        gh_msg = " • Pushed to GitHub (IAMGREATER/omarchy-dotfiles)"
                    else:
                        gh_msg = f" • GitHub push warning: {push_res.stderr.strip()[:60]}"
                else:
                    gh_msg = " • GitHub already up to date"

            # 3. Copy to VAULT external drive if selected
            vault_msg = ""
            if dest_vault:
                cur_step += 1
                self.update_ui_status("Copying to VAULT external drive...", cur_step / total_steps)
                vault_target = os.path.join(self.vault_dir, f"Omarchy Backup {date_str}")
                os.makedirs(vault_target, exist_ok=True)
                subprocess.run(["rsync", "-a", "--delete", f"{repo}/", f"{vault_target}/"])
                vault_msg = f" • Synced to VAULT ({vault_target})"

            # 4. Copy to Custom directory if selected
            custom_msg = ""
            if dest_custom and self.custom_path:
                cur_step += 1
                self.update_ui_status(f"Copying to {self.custom_path}...", cur_step / total_steps)
                custom_target = os.path.join(self.custom_path, f"Omarchy Backup {date_str}")
                os.makedirs(custom_target, exist_ok=True)
                subprocess.run(["rsync", "-a", "--delete", f"{repo}/", f"{custom_target}/"])
                custom_msg = f" • Synced to {custom_target}"

            final_msg = f"✅ Backup successful!\n{gh_msg}\n{vault_msg}\n{custom_msg}".strip()
            self.finish_backup(True, final_msg)

        except Exception as e:
            self.finish_backup(False, f"❌ Backup failed: {str(e)}")

if __name__ == "__main__":
    app = BackupApp()
    sys.exit(app.run(sys.argv))
