# ─── Config persistence ────────────────────────────────────────────────────────
CONFIG_PATH = os.path.expanduser("~/.config/omarchy/backup-hub.json")

def load_config():
    try:
        with open(CONFIG_PATH) as f:
            return json.load(f)
    except Exception:
        return {}

def save_config(data):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(data, f, indent=2)

# ─── Secret scrubbing ──────────────────────────────────────────────────────────
SECRET_PATTERN = re.compile(
    r'(.*(KEY|TOKEN|SECRET|PASSWORD|PASS|PWD|API|AUTH|CREDENTIAL|GH_|GITHUB_).*=).*',
    re.IGNORECASE
)

def scrub_secrets(content: str) -> str:
    """Replace any export/assignment of secrets with a placeholder value."""
    lines = []
    for line in content.splitlines(keepends=True):
        m = SECRET_PATTERN.match(line)
        if m:
            lines.append(m.group(1) + '"YOUR_SECRET_HERE"\n')
        else:
            lines.append(line)
    return "".join(lines)

def scrub_and_copy(src_path: str, dst_path: str):
    """Copy a text file, scrubbing any secret-looking lines."""
    try:
        with open(src_path, "r", errors="replace") as f:
            content = f.read()
        cleaned = scrub_secrets(content)
        os.makedirs(os.path.dirname(dst_path), exist_ok=True)
        with open(dst_path, "w") as f:
            f.write(cleaned)
    except Exception:
        subprocess.run(["cp", src_path, dst_path])

