#!/usr/bin/env python3
"""
Omarchy Windows 11 Aero Snap & Keyboard Snapping:
- Fully independent window snapping in the unified Floating Layer (floating = true).
- Snapping Window A NEVER un-floats or alters Window B.
- Pure floating maximization (fullscreen = 0) so Alt+Tab and click-to-raise always work.
- Automatically saves state immediately into window_geometry.json so reopened apps restore in same split.
- Dual-window middle-line dividing adjustment for side-by-side floating pairs.
- Aero Snap edge drag daemon.
"""

import sys
import os
import glob
import json
import time
import signal
import socket
import select
import struct
import subprocess

STATE_FILE = os.path.expanduser("~/.local/state/omarchy/snap_state.json")
GEOM_FILE = os.path.expanduser("~/.local/state/omarchy/window_geometry.json")

EDGE_THRESHOLD = 15
CORNER_EDGE_THRESHOLD = 30
RESIZE_STEP = 50
GAP = 2

EV_KEY = 1
BTN_LEFT = 0x110
BTN_TOUCH = 0x14a
EVENT_FORMAT = "qqHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)


def find_live_socket2():
    uid = os.getuid()
    runtime_dir = os.getenv("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    os.environ["XDG_RUNTIME_DIR"] = runtime_dir

    cur_sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
    if cur_sig:
        for base in [f"{runtime_dir}/hypr/{cur_sig}", f"/tmp/hypr/{cur_sig}"]:
            sock_p = f"{base}/.socket2.sock"
            if os.path.exists(sock_p):
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.settimeout(0.2)
                    s.connect(sock_p)
                    s.close()
                    return cur_sig
                except Exception:
                    pass

    candidates = glob.glob(f"{runtime_dir}/hypr/*/.socket2.sock") + glob.glob(f"/tmp/hypr/*/.socket2.sock")
    if candidates:
        candidates.sort(key=lambda p: os.path.getmtime(p), reverse=True)
        for cand in candidates:
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(0.2)
                s.connect(cand)
                s.close()
                sig = os.path.basename(os.path.dirname(cand))
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig
                return sig
            except Exception:
                continue

    return None


def ensure_hypr_env():
    return find_live_socket2()


def get_hypr_data():
    ensure_hypr_env()
    monitors, active_win, clients = [], None, []
    cursor_pos = (0, 0)
    try:
        monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"], timeout=1))
    except Exception:
        pass
    try:
        active_win = json.loads(subprocess.check_output(["hyprctl", "activewindow", "-j"], timeout=1))
    except Exception:
        pass
    try:
        clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], timeout=1))
    except Exception:
        pass
    try:
        cursor_raw = subprocess.check_output(["hyprctl", "cursorpos"], timeout=0.3).decode().strip()
        cursor_pos = tuple(int(v.strip()) for v in cursor_raw.split(","))
    except Exception:
        pass
    return monitors, active_win, clients, cursor_pos


def find_active_monitor(monitors, active_win, cursor_pos):
    if active_win and "monitor" in active_win:
        for m in monitors:
            if m.get("id") == active_win["monitor"] and not m.get("disabled", False):
                return m

    cur_x, cur_y = cursor_pos
    for m in monitors:
        if not m.get("disabled", False):
            mx, my = m["x"], m["y"]
            mw, mh = m["width"], m["height"]
            if mx <= cur_x < mx + mw and my <= cur_y < my + mh:
                return m

    for m in monitors:
        if m.get("focused", False) and not m.get("disabled", False):
            return m

    return monitors[0] if monitors else None


def load_state():
    try:
        if os.path.exists(STATE_FILE):
            with open(STATE_FILE, "r") as f:
                return json.load(f)
    except Exception:
        pass
    return {}


def save_state(state):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            json.dump(state, f, indent=2)
    except Exception:
        pass


def save_window_geometry(cls, state_entry):
    if not cls:
        return
    try:
        os.makedirs(os.path.dirname(GEOM_FILE), exist_ok=True)
        geom = {}
        if os.path.exists(GEOM_FILE):
            try:
                with open(GEOM_FILE, "r") as f:
                    geom = json.load(f)
            except Exception:
                geom = {}
        geom[cls] = state_entry
        with open(GEOM_FILE, "w") as f:
            json.dump(geom, f, indent=2)
    except Exception:
        pass


def hypr_eval(code):
    ensure_hypr_env()
    try:
        subprocess.run(["hyprctl", "eval", code], capture_output=True, timeout=1.5)
    except Exception:
        pass


def clamp_geometry(tx, ty, tw, th, avail_x, avail_y, avail_w, avail_h):
    cw = max(250, min(tw, avail_w))
    ch = max(180, min(th, avail_h))
    cx = max(avail_x, min(tx, avail_x + avail_w - cw))
    cy = max(avail_y, min(ty, avail_y + avail_h - ch))
    return int(cx), int(cy), int(cw), int(ch)


def adjust_width_direction(direction):
    monitors, win, clients, cursor_pos = get_hypr_data()
    if not win or not win.get("address"):
        return

    addr = win["address"]
    norm_addr = addr if addr.startswith("0x") else ("0x" + addr)
    cls = win.get("initialClass") or win.get("class", "")
    ws_id = win.get("workspace", {}).get("id")

    mon = find_active_monitor(monitors, win, cursor_pos)
    if not mon:
        return

    res = mon.get("reserved", [0, 0, 0, 0])
    avail_x = mon["x"] + res[0] + GAP
    avail_y = mon["y"] + res[1] + GAP
    avail_w = mon["width"] - res[0] - res[2] - (GAP * 2)
    avail_h = mon["height"] - res[1] - res[3] - (GAP * 2)

    ws_clients = [c for c in clients if c.get("workspace", {}).get("id") == ws_id and c.get("mapped") and not c.get("hidden")]

    is_right = direction in ("right", "expand", "bigger", "+", "equal", "plus", "grow", "resize-right", "resize_right", "resizeright")
    step = RESIZE_STEP if is_right else -RESIZE_STEP

    # Find side-by-side pair if exists
    left_win = None
    right_win = None
    for c in ws_clients:
        cx, cy = c.get("at", [0, 0])
        cw, ch = c.get("size", [0, 0])
        if abs(cx - avail_x) <= 35 and ch >= avail_h - 60:
            left_win = c
        elif cx > avail_x + 100 and ch >= avail_h - 60:
            right_win = c

    if left_win and right_win and left_win["address"] != right_win["address"]:
        lw_addr = left_win["address"]
        rw_addr = right_win["address"]
        lw_cls = left_win.get("initialClass") or left_win.get("class", "")
        rw_cls = right_win.get("initialClass") or right_win.get("class", "")

        lw_spec = f"address:{lw_addr}"
        rw_spec = f"address:{rw_addr}"

        cur_lw = left_win["size"][0]
        new_lw = max(300, min(avail_w - 300 - GAP, cur_lw + step))
        new_rw = avail_w - new_lw - GAP
        new_rx = avail_x + new_lw + GAP

        hypr_eval(f'hl.dispatch(hl.dsp.window.resize({{ window = "{lw_spec}", x = {new_lw}, y = {avail_h} }})); hl.dispatch(hl.dsp.window.move({{ window = "{lw_spec}", x = {avail_x}, y = {avail_y} }})); hl.dispatch(hl.dsp.window.resize({{ window = "{rw_spec}", x = {new_rw}, y = {avail_h} }})); hl.dispatch(hl.dsp.window.move({{ window = "{rw_spec}", x = {new_rx}, y = {avail_y} }}))')

        save_window_geometry(lw_cls, {
            "mode": "geometry",
            "snap": "custom",
            "ratio_w": new_lw / max(1, avail_w),
            "ratio_h": 1.0,
            "ratio_x": 0.0,
            "ratio_y": 0.0,
            "align_right": False,
            "align_bottom": False
        })
        save_window_geometry(rw_cls, {
            "mode": "geometry",
            "snap": "custom",
            "ratio_w": new_rw / max(1, avail_w),
            "ratio_h": 1.0,
            "ratio_x": (new_rx - avail_x) / max(1, avail_w),
            "ratio_y": 0.0,
            "align_right": True,
            "align_bottom": False
        })
    else:
        # Standalone resize
        cur_w = win["size"][0]
        cur_h = win["size"][1]
        cur_x = win["at"][0]
        cur_y = win["at"][1]
        new_w = max(300, min(avail_w, cur_w + step))
        new_x = max(avail_x, min(cur_x, avail_x + avail_w - new_w))
        hypr_eval(f'hl.dispatch(hl.dsp.window.resize({{ window = "address:{norm_addr}", x = {new_w}, y = {cur_h} }})); hl.dispatch(hl.dsp.window.move({{ window = "address:{norm_addr}", x = {new_x}, y = {cur_y} }}))')

        save_window_geometry(cls, {
            "mode": "geometry",
            "snap": "custom",
            "ratio_w": new_w / max(1, avail_w),
            "ratio_h": cur_h / max(1, avail_h),
            "ratio_x": max(0.0, min(1.0, (new_x - avail_x) / max(1, avail_w))),
            "ratio_y": max(0.0, min(1.0, (cur_y - avail_y) / max(1, avail_h))),
            "align_right": abs((new_x + new_w) - (avail_x + avail_w)) <= 25,
            "align_bottom": abs((cur_y + cur_h) - (avail_y + avail_h)) <= 25
        })


def snap_window(action, explicit_win=None):
    monitors, active_win, clients, cursor_pos = get_hypr_data()
    win = explicit_win or active_win

    # If win is None or an overlay/menu (eswl-overlay, rofi, quickshell, etc.), find window under cursor
    if not win or not win.get("address") or win.get("class") in ("eswl-overlay", "eswl-tray", "rofi", "fuzzel", "wofi", "quickshell"):
        cur_x, cur_y = cursor_pos
        for c in reversed(clients):
            if c.get("mapped") and not c.get("hidden") and c.get("class") not in ("eswl-overlay", "eswl-tray", "rofi", "fuzzel", "wofi", "quickshell"):
                wx, wy = c.get("at", [0, 0])
                ww, wh = c.get("size", [0, 0])
                if wx <= cur_x <= wx + ww and wy <= cur_y <= wy + wh:
                    win = c
                    break

        if not win or win.get("class") in ("eswl-overlay", "eswl-tray", "rofi", "fuzzel", "wofi", "quickshell"):
            for c in clients:
                if c.get("mapped") and not c.get("hidden") and c.get("class") not in ("eswl-overlay", "eswl-tray", "rofi", "fuzzel", "wofi", "quickshell"):
                    win = c
                    break

    if not win or not win.get("address"):
        return

    addr = win["address"]
    norm_addr = addr if addr.startswith("0x") else ("0x" + addr)
    window_spec = f"address:{norm_addr}"
    cls = win.get("initialClass") or win.get("class", "")

    mon = find_active_monitor(monitors, win, cursor_pos)
    if not mon:
        return

    res = mon.get("reserved", [0, 0, 0, 0])
    avail_x = mon["x"] + res[0] + GAP
    avail_y = mon["y"] + res[1] + GAP
    avail_w = mon["width"] - res[0] - res[2] - (GAP * 2)
    avail_h = mon["height"] - res[1] - res[3] - (GAP * 2)

    half_w = int((avail_w - GAP) / 2)
    half_h = int((avail_h - GAP) / 2)
    right_x = avail_x + half_w + GAP
    bottom_y = avail_y + half_h + GAP

    all_state = load_state()
    win_state = all_state.get(norm_addr, {})
    cur_snap = win_state.get("snap", "none")
    orig_geom = win_state.get("orig_geom")

    if cur_snap in ("none", None) and not orig_geom:
        orig_geom = {
            "x": win["at"][0],
            "y": win["at"][1],
            "w": win["size"][0],
            "h": win["size"][1],
            "floating": True,
            "fullscreen": 0,
        }
        win_state["orig_geom"] = orig_geom

    if not win.get("floating", True):
        hypr_eval(f'hl.dispatch(hl.dsp.window.float({{ window = "{window_spec}" }}))')

    # 1. Super + Up / Swipe Up / Cycle: Original -> Maximize -> Center Pop-up -> Original
    if action in ("up", "top", "maximize", "cycle-up", "cycle_up", "cycle", "cycle-state", "cyclestate"):
        cur_w = win["size"][0]
        cur_h = win["size"][1]
        cur_x = win["at"][0]
        cur_y = win["at"][1]

        popup_w = max(400, int(avail_w * 0.70))
        popup_h = max(300, int(avail_h * 0.70))
        popup_x = avail_x + (avail_w - popup_w) // 2
        popup_y = avail_y + (avail_h - popup_h) // 2

        is_max = (cur_snap == "maximize") or (abs(cur_w - avail_w) <= 20 and abs(cur_h - avail_h) <= 20)
        is_popup = (cur_snap == "popup") or (abs(cur_w - popup_w) <= 35 and abs(cur_h - popup_h) <= 35 and abs(cur_x - popup_x) <= 35 and abs(cur_y - popup_y) <= 35)

        started_max = win_state.get("started_maximized", False)

        if is_max or cur_snap == "maximize":
            # Transition from Maximize -> Pop-up
            tx, ty, tw, th = popup_x, popup_y, popup_w, popup_h
            win_state["snap"] = "popup"
            if not orig_geom:
                win_state["started_maximized"] = True
        elif is_popup or cur_snap == "popup":
            # Transition from Pop-up -> Original (or Maximize if started max)
            if orig_geom and not started_max:
                tx, ty, tw, th = orig_geom["x"], orig_geom["y"], orig_geom["w"], orig_geom["h"]
                win_state["snap"] = "none"
            else:
                tx, ty, tw, th = avail_x, avail_y, avail_w, avail_h
                win_state["snap"] = "maximize"
        else:
            # Currently in original / normal / un-maximized state -> save orig and go to Maximize
            win_state["orig_geom"] = {
                "x": cur_x,
                "y": cur_y,
                "w": cur_w,
                "h": cur_h,
                "floating": True,
            }
            win_state["started_maximized"] = False
            tx, ty, tw, th = avail_x, avail_y, avail_w, avail_h
            win_state["snap"] = "maximize"

        cx, cy, cw, ch = clamp_geometry(tx, ty, tw, th, avail_x, avail_y, avail_w, avail_h)
        hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.fullscreen_state({{ window = "{window_spec}", internal = 0, client = 0 }})); hl.dispatch(hl.dsp.window.resize({{ window = "{window_spec}", x = {cw}, y = {ch} }})); hl.dispatch(hl.dsp.window.move({{ window = "{window_spec}", x = {cx}, y = {cy} }})); hl.dispatch(hl.dsp.window.bring_to_top({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.alter_zorder({{ window = "{window_spec}", mode = "top" }}))')
        all_state[norm_addr] = win_state
        save_state(all_state)
        return

    # 2. Super + Down / Bottom Half / Restore
    if action in ("down", "bottom", "restore"):
        if action == "restore" and orig_geom:
            cx, cy, cw, ch = clamp_geometry(orig_geom["x"], orig_geom["y"], orig_geom["w"], orig_geom["h"], avail_x, avail_y, avail_w, avail_h)
            win_state["snap"] = "none"
            win_state["orig_geom"] = None
            snap_to_save = "custom"
        else:
            tx, ty, tw, th = avail_x, bottom_y, avail_w, half_h
            cx, cy, cw, ch = clamp_geometry(tx, ty, tw, th, avail_x, avail_y, avail_w, avail_h)
            win_state["snap"] = "bottom-half"
            snap_to_save = "bottom-half"

        hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.fullscreen_state({{ window = "{window_spec}", internal = 0, client = 0 }})); hl.dispatch(hl.dsp.window.resize({{ window = "{window_spec}", x = {cw}, y = {ch} }})); hl.dispatch(hl.dsp.window.move({{ window = "{window_spec}", x = {cx}, y = {cy} }})); hl.dispatch(hl.dsp.window.bring_to_top({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.alter_zorder({{ window = "{window_spec}", mode = "top" }}))')
        all_state[norm_addr] = win_state
        save_state(all_state)
        if snap_to_save == "bottom-half":
            save_window_geometry(cls, {"mode": "geometry", "snap": "bottom-half", "ratio_w": 1.0, "ratio_h": 0.5})
        else:
            save_window_geometry(cls, {
                "mode": "geometry",
                "snap": "custom",
                "ratio_w": cw / max(1, avail_w),
                "ratio_h": ch / max(1, avail_h),
                "ratio_x": (cx - avail_x) / max(1, avail_w),
                "ratio_y": (cy - avail_y) / max(1, avail_h),
                "align_right": False,
                "align_bottom": False
            })
        return

    # 3. Super + Left / Right: Exact 50% Half Snap
    if action in ("left", "right"):
        if action == "left":
            tx, ty, tw, th = avail_x, avail_y, half_w, avail_h
        else:
            tx, ty, tw, th = right_x, avail_y, half_w, avail_h

        cx, cy, cw, ch = clamp_geometry(tx, ty, tw, th, avail_x, avail_y, avail_w, avail_h)
        hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.fullscreen_state({{ window = "{window_spec}", internal = 0, client = 0 }})); hl.dispatch(hl.dsp.window.resize({{ window = "{window_spec}", x = {cw}, y = {ch} }})); hl.dispatch(hl.dsp.window.move({{ window = "{window_spec}", x = {cx}, y = {cy} }})); hl.dispatch(hl.dsp.window.bring_to_top({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.alter_zorder({{ window = "{window_spec}", mode = "top" }}))')
        win_state["snap"] = action
        win_state["orig_geom"] = {"x": cx, "y": cy, "w": cw, "h": ch, "floating": True, "fullscreen": 0}
        all_state[norm_addr] = win_state
        save_state(all_state)
        save_window_geometry(cls, {"mode": "geometry", "snap": action, "ratio_w": 0.5, "ratio_h": 1.0})
        return

    # 4. Corner Quadrants (Top-Left, Top-Right, Bottom-Left, Bottom-Right)
    if action == "top-left":
        tx, ty, tw, th = avail_x, avail_y, half_w, half_h
    elif action == "top-right":
        tx, ty, tw, th = right_x, avail_y, half_w, half_h
    elif action == "bottom-left":
        tx, ty, tw, th = avail_x, bottom_y, half_w, half_h
    elif action == "bottom-right":
        tx, ty, tw, th = right_x, bottom_y, half_w, half_h
    elif action in ("vertical", "vert", "max-vert", "maximize-vertical", "maximize-vertically", "vmax"):
        cur_x = win["at"][0]
        cur_w = win["size"][0]
        tx = max(avail_x, min(cur_x, avail_x + avail_w - cur_w))
        ty = avail_y
        tw = min(cur_w, avail_w)
        th = avail_h
    else:
        return

    cx, cy, cw, ch = clamp_geometry(tx, ty, tw, th, avail_x, avail_y, avail_w, avail_h)
    hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.fullscreen_state({{ window = "{window_spec}", internal = 0, client = 0 }})); hl.dispatch(hl.dsp.window.resize({{ window = "{window_spec}", x = {cw}, y = {ch} }})); hl.dispatch(hl.dsp.window.move({{ window = "{window_spec}", x = {cx}, y = {cy} }})); hl.dispatch(hl.dsp.window.bring_to_top({{ window = "{window_spec}" }})); hl.dispatch(hl.dsp.window.alter_zorder({{ window = "{window_spec}", mode = "top" }}))')
    win_state["snap"] = action
    win_state["orig_geom"] = {"x": cx, "y": cy, "w": cw, "h": ch, "floating": True, "fullscreen": 0}
    all_state[norm_addr] = win_state
    save_state(all_state)
    if action in ("vertical", "vert", "max-vert", "maximize-vertical", "maximize-vertically", "vmax"):
        save_window_geometry(cls, {
            "mode": "geometry",
            "snap": "vertical",
            "ratio_w": cw / max(1, avail_w),
            "ratio_h": 1.0,
            "ratio_x": (cx - avail_x) / max(1, avail_w),
            "ratio_y": 0.0,
            "align_right": abs((cx + cw) - (avail_x + avail_w)) <= 25,
            "align_bottom": True
        })
    else:
        save_window_geometry(cls, {"mode": "geometry", "snap": action, "ratio_w": 0.5, "ratio_h": 0.5})


def get_device_name(fd):
    try:
        import fcntl
        buf = bytearray(256)
        fcntl.ioctl(fd, 0x80ff4506, buf, True)
        return buf.split(b"\x00")[0].decode("utf-8", "replace")
    except Exception:
        return ""


def run_aero_snap_daemon():
    print("Starting Omarchy Aero Snap Mouse Drag Daemon...", flush=True)
    ensure_hypr_env()

    device_fds = []
    for p in sorted(glob.glob("/dev/input/event*"), key=lambda x: int(x.replace("/dev/input/event", ""))):
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            name = get_device_name(fd)
            lower = name.lower()
            is_mouse_or_touchpad = any(k in lower for k in ["mouse", "touchpad", "trackpoint"])
            is_non_pointer = any(k in lower for k in ["virtual", "pen", "stylus", "tablet", "wacom", "finger", "touch", "keyboard", "switch", "button"])
            if is_mouse_or_touchpad and not is_non_pointer:
                device_fds.append(fd)
            else:
                os.close(fd)
        except Exception:
            pass

    epoll = select.epoll()
    for fd in device_fds:
        try:
            epoll.register(fd, select.EPOLLIN)
        except Exception:
            pass

    btn_is_down = False

    def on_button_release():
        nonlocal btn_is_down
        if not btn_is_down:
            return
        btn_is_down = False

        monitors, active_win, clients, (cx, cy) = get_hypr_data()
        if not active_win or not active_win.get("address"):
            return

        mon = find_active_monitor(monitors, active_win, (cx, cy))
        if not mon:
            return

        mx, my = mon["x"], mon["y"]
        mw, mh = mon["width"], mon["height"]

        rel_x = cx - mx
        rel_y = cy - my

        target = None

        is_left = rel_x <= CORNER_EDGE_THRESHOLD
        is_right = rel_x >= mw - CORNER_EDGE_THRESHOLD
        is_top = rel_y <= CORNER_EDGE_THRESHOLD
        is_bottom = rel_y >= mh - CORNER_EDGE_THRESHOLD

        if is_left and is_top:
            target = "top-left"
        elif is_right and is_top:
            target = "top-right"
        elif is_left and is_bottom:
            target = "bottom-left"
        elif is_right and is_bottom:
            target = "bottom-right"
        elif rel_y <= EDGE_THRESHOLD:
            target = "maximize"
        elif rel_x <= EDGE_THRESHOLD:
            target = "left"
        elif rel_x >= mw - EDGE_THRESHOLD:
            target = "right"

        if target:
            snap_window(target, explicit_win=active_win)

    def sig_handler(sig, frame):
        for fd in device_fds:
            try:
                os.close(fd)
            except Exception:
                pass
            sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    while True:
        try:
            events = epoll.poll(timeout=2.0)
            for fd, event in events:
                if event & select.EPOLLIN:
                    try:
                        data = os.read(fd, EVENT_SIZE * 32)
                        for i in range(0, len(data), EVENT_SIZE):
                            chunk = data[i:i + EVENT_SIZE]
                            if len(chunk) == EVENT_SIZE:
                                sec, usec, ev_type, ev_code, ev_val = struct.unpack(EVENT_FORMAT, chunk)
                                if ev_type == EV_KEY and ev_code == BTN_LEFT:
                                    if ev_val == 1:
                                        btn_is_down = True
                                    elif ev_val == 0:
                                        on_button_release()
                    except OSError:
                        pass
        except Exception:
            pass


def main():
    if len(sys.argv) > 1:
        raw = sys.argv[1].lower()
        clean = raw.lstrip("-")

        if clean in ("daemon", "d"):
            run_aero_snap_daemon()
            return
        elif raw in ("-", "minus", "--minus", "shrink", "smaller", "resize-left", "resize_left", "resizeleft"):
            adjust_width_direction("left")
        elif raw in ("+", "=", "plus", "--plus", "equal", "--equal", "expand", "bigger", "grow", "resize-right", "resize_right", "resizeright"):
            adjust_width_direction("right")
        elif clean in ("left", "l"):
            snap_window("left")
        elif clean in ("right", "r"):
            snap_window("right")
        elif clean in ("up", "u", "top", "maximize"):
            snap_window("up")
        elif clean in ("down", "d", "bottom", "restore"):
            snap_window("down")
        elif clean in ("top-left", "tl", "topleft"):
            snap_window("top-left")
        elif clean in ("top-right", "tr", "topright"):
            snap_window("top-right")
        elif clean in ("bottom-left", "bl", "bottomleft"):
            snap_window("bottom-left")
        elif clean in ("bottom-right", "br", "bottomright"):
            snap_window("bottom-right")
        elif clean in ("restore", "center"):
            snap_window("restore")
        elif clean in ("vertical", "vert", "max-vert", "maximize-vertical", "maximize-vertically", "vmax"):
            snap_window("vertical")
        elif clean in ("cycle-up", "cycle_up", "cycle", "cycle-state", "cyclestate"):
            snap_window("cycle-up")
        else:
            print(f"Usage: {sys.argv[0]} [left|right|up|down|top-left|top-right|bottom-left|bottom-right|vertical|cycle-up|resize-left|resize-right|--daemon]")
    else:
        snap_window("up")


if __name__ == "__main__":
    main()
