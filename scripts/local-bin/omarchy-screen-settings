#!/usr/bin/env python3
import os
import sys
import json
import subprocess
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio

SHELL_JSON = os.path.expanduser("~/.config/omarchy/shell.json")
BRANDING_DIR = os.path.expanduser("~/.config/omarchy/branding")
SCREENSAVER_TXT = os.path.join(BRANDING_DIR, "screensaver.txt")
SCREENSAVER_ORIG = os.path.join(BRANDING_DIR, "screensaver.txt.original")
BLACK_PAYLOAD = "\033[30m.\033[0m"

class ScreenSettingsWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.set_title("Screen & Screensaver Settings")
        self.set_default_size(520, 680)

        self.loading = True
        self.config_data = self.load_shell_json()

        # Main Layout
        toolbar_view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar_view.add_top_bar(header)

        # Content container
        toast_overlay = Adw.ToastOverlay()
        self.toast_overlay = toast_overlay

        page = Adw.PreferencesPage()
        page.set_title("Display & Idle")

        # ========================================================
        # GROUP 1: SCREENSAVER
        # ========================================================
        saver_group = Adw.PreferencesGroup()
        saver_group.set_title("Screensaver")
        saver_group.set_description("Configure screensaver appearance and idle activation delay.")

        # Screensaver Enabled Switch
        self.saver_switch = Adw.SwitchRow()
        self.saver_switch.set_title("Enable Screensaver")
        self.saver_switch.set_subtitle("Activate screensaver automatically when computer is idle")
        self.saver_switch.connect("notify::active", self.on_saver_enabled_changed)
        saver_group.add(self.saver_switch)

        # Screensaver Style Combo
        self.style_row = Adw.ComboRow()
        self.style_row.set_title("Screensaver Style")
        self.style_row.set_subtitle("Visual presentation when screensaver starts")
        style_model = Gtk.StringList.new([
            "Dark Black Screen (Pure Black)",
            "Animated Logo (Dynamic Omarchy ASCII)",
            "Custom Branding Text"
        ])
        self.style_row.set_model(style_model)
        self.style_row.connect("notify::selected", self.on_style_changed)
        saver_group.add(self.style_row)

        # Screensaver Timeout
        self.saver_time_row = Adw.SpinRow.new_with_range(0.5, 60.0, 0.5)
        self.saver_time_row.set_title("Activation Timeout (Minutes)")
        self.saver_time_row.set_subtitle("Time idle before screensaver starts")
        self.saver_time_row.connect("notify::value", self.on_saver_time_changed)
        saver_group.add(self.saver_time_row)

        # Preview Button Row
        preview_row = Adw.ActionRow()
        preview_row.set_title("Preview Screensaver")
        preview_row.set_subtitle("Test screensaver immediately (move mouse to dismiss)")
        test_btn = Gtk.Button(label="Test Now")
        test_btn.set_valign(Gtk.Align.CENTER)
        test_btn.add_css_class("suggested-action")
        test_btn.connect("clicked", self.on_test_screensaver)
        preview_row.add_suffix(test_btn)
        saver_group.add(preview_row)

        page.add(saver_group)

        # ========================================================
        # GROUP 2: SCREEN LOCK & SLEEP (DPMS)
        # ========================================================
        lock_group = Adw.PreferencesGroup()
        lock_group.set_title("Screen Off and Lock")
        lock_group.set_description("Configure screen lock and monitor power sleep.")

        # Lock Timeout
        self.lock_time_row = Adw.SpinRow.new_with_range(1.0, 120.0, 1.0)
        self.lock_time_row.set_title("Screen Lock Timeout (Minutes)")
        self.lock_time_row.set_subtitle("Time idle before locking system and turning off display")
        self.lock_time_row.connect("notify::value", self.on_lock_time_changed)
        lock_group.add(self.lock_time_row)

        # Lock Design Combo
        self.design_row = Adw.ComboRow()
        self.design_row.set_title("Lock Screen Design")
        self.design_row.set_subtitle("Visual theme for the password prompt")
        self.designs_list = self.get_available_designs()
        design_model = Gtk.StringList.new([d.capitalize() for d in self.designs_list])
        self.design_row.set_model(design_model)
        self.design_row.connect("notify::selected", self.on_design_changed)
        lock_group.add(self.design_row)

        # Lock Now Button Row
        lock_now_row = Adw.ActionRow()
        lock_now_row.set_title("Lock and Turn Off Display")
        lock_now_row.set_subtitle("Lock session immediately")
        lock_btn = Gtk.Button(label="Lock Now")
        lock_btn.set_valign(Gtk.Align.CENTER)
        lock_btn.connect("clicked", self.on_lock_now)
        lock_now_row.add_suffix(lock_btn)
        lock_group.add(lock_now_row)

        page.add(lock_group)

        # Load current system values
        self.populate_values()

        toast_overlay.set_child(page)
        toolbar_view.set_content(toast_overlay)
        self.set_content(toolbar_view)
        self.loading = False

    def load_shell_json(self):
        try:
            if os.path.exists(SHELL_JSON):
                with open(SHELL_JSON, "r", encoding="utf-8") as f:
                    return json.load(f)
        except Exception as e:
            print("Error loading shell.json:", e)
        return {}

    def save_shell_json(self):
        if self.loading:
            return
        try:
            with open(SHELL_JSON, "w", encoding="utf-8") as f:
                json.dump(self.config_data, f, indent=2)
            self.show_toast("Settings saved and reloaded")
        except Exception as e:
            self.show_toast(f"Error saving settings: {e}")

    def show_toast(self, message):
        toast = Adw.Toast.new(message)
        toast.set_timeout(2)
        self.toast_overlay.add_toast(toast)

    def get_available_designs(self):
        default_designs = ["island", "zen", "aurora", "classic", "terminal", "neon", "storm", "river"]
        designs_dir = os.path.expanduser("~/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer/designs")
        if os.path.isdir(designs_dir):
            found = []
            for f in sorted(os.listdir(designs_dir)):
                if f.endswith(".qml") and not f.startswith("Design") and not f.startswith("Unlock"):
                    name = os.path.splitext(f)[0].lower()
                    found.append(name)
            if found:
                return found
        return default_designs

    def populate_values(self):
        idle_cfg = self.config_data.get("idle", {})
        saver_sec = idle_cfg.get("screensaver", 150)
        lock_sec = idle_cfg.get("lock", 300)

        # Screensaver Timeout
        self.saver_time_row.set_value(round(saver_sec / 60.0, 1))
        self.lock_time_row.set_value(round(lock_sec / 60.0, 1))

        # Screensaver Enabled Check
        state_dir = os.path.expanduser("~/.local/state/omarchy/toggles")
        is_off = os.path.exists(os.path.join(state_dir, "screensaver-off"))
        self.saver_switch.set_active(not is_off)

        # Detect screensaver style
        if os.path.exists(SCREENSAVER_TXT):
            with open(SCREENSAVER_TXT, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
                if BLACK_PAYLOAD in content or len(content.strip()) < 5:
                    self.style_row.set_selected(0) # Dark Black Screen
                elif os.path.exists(SCREENSAVER_ORIG):
                    with open(SCREENSAVER_ORIG, "r", encoding="utf-8", errors="ignore") as fo:
                        orig = fo.read()
                        if orig == content:
                            self.style_row.set_selected(1) # Animated Logo
                        else:
                            self.style_row.set_selected(2) # Custom
                else:
                    self.style_row.set_selected(1)
        else:
            self.style_row.set_selected(0)

        # Lock design
        current_design = "island"
        for pl in self.config_data.get("plugins", []):
            if pl.get("id") == "io.github.sirjul1337.lock-explorer":
                current_design = pl.get("design", "island").lower()
                break

        if current_design in self.designs_list:
            self.design_row.set_selected(self.designs_list.index(current_design))

    def on_saver_enabled_changed(self, row, param):
        if self.loading: return
        active = self.saver_switch.get_active()
        state_dir = os.path.expanduser("~/.local/state/omarchy/toggles")
        os.makedirs(state_dir, exist_ok=True)
        toggle_file = os.path.join(state_dir, "screensaver-off")
        if active:
            if os.path.exists(toggle_file):
                os.remove(toggle_file)
            self.show_toast("Screensaver enabled")
        else:
            with open(toggle_file, "w") as f: f.write("1")
            self.show_toast("Screensaver disabled")

    def on_style_changed(self, row, param):
        if self.loading: return
        idx = self.style_row.get_selected()
        os.makedirs(BRANDING_DIR, exist_ok=True)

        if idx == 0: # Black Screen
            if os.path.exists(SCREENSAVER_TXT) and not os.path.exists(SCREENSAVER_ORIG):
                subprocess.run(["cp", SCREENSAVER_TXT, SCREENSAVER_ORIG], check=False)
            with open(SCREENSAVER_TXT, "w", encoding="utf-8") as f:
                f.write(BLACK_PAYLOAD)
            self.show_toast("Screensaver set to Dark Black Screen")
        elif idx == 1: # Animated Logo
            if os.path.exists(SCREENSAVER_ORIG):
                subprocess.run(["cp", SCREENSAVER_ORIG, SCREENSAVER_TXT], check=False)
            else:
                logo_src = "/usr/share/omarchy/logo.txt"
                if os.path.exists(logo_src):
                    subprocess.run(["cp", logo_src, SCREENSAVER_TXT], check=False)
            self.show_toast("Screensaver set to Animated Omarchy Logo")
        elif idx == 2: # Custom Branding Text
            self.show_toast("Edit ~/.config/omarchy/branding/screensaver.txt to customize")

    def on_saver_time_changed(self, row, param):
        if self.loading: return
        minutes = self.saver_time_row.get_value()
        seconds = int(minutes * 60)
        if "idle" not in self.config_data:
            self.config_data["idle"] = {}
        self.config_data["idle"]["screensaver"] = seconds
        self.save_shell_json()

    def on_lock_time_changed(self, row, param):
        if self.loading: return
        minutes = self.lock_time_row.get_value()
        seconds = int(minutes * 60)
        if "idle" not in self.config_data:
            self.config_data["idle"] = {}
        self.config_data["idle"]["lock"] = seconds
        self.save_shell_json()

    def on_design_changed(self, row, param):
        if self.loading: return
        idx = self.design_row.get_selected()
        selected_design = self.designs_list[idx]
        for pl in self.config_data.get("plugins", []):
            if pl.get("id") == "io.github.sirjul1337.lock-explorer":
                pl["design"] = selected_design
                break
        self.save_shell_json()

    def on_test_screensaver(self, btn):
        subprocess.Popen(["omarchy-launch-screensaver", "force"])

    def on_lock_now(self, btn):
        subprocess.Popen(["omarchy", "system", "lock"])


class ScreenSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="org.omarchy.ScreenSettings",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = ScreenSettingsWindow(application=self)
        win.present()

if __name__ == "__main__":
    app = ScreenSettingsApp()
    sys.exit(app.run(sys.argv))
