#!/usr/bin/env python3
import datetime as dt
import json
import os
import re
import sqlite3

def main():
    home = os.path.expanduser("~")
    db_path = os.path.join(home, ".copilot", "session-store.db")
    cache_path = os.path.join(home, ".cache", "copilot", "copilot-user-cache.json")

    tier_label = "GitHub Account"
    status_text = "Connected"
    limits = []

    # 1. Parse cache for quota & plan
    if os.path.exists(cache_path):
        try:
            with open(cache_path, "r", encoding="utf-8") as f:
                text = f.read()
            text = re.sub(r"^\s*//.*$", "", text, flags=re.MULTILINE)
            cdata = json.loads(text)
            cache_entry = next(iter(cdata.get("copilotUserCache", {}).values()), {})
            resp = cache_entry.get("response", {})
            login = resp.get("login", "")
            plan = resp.get("copilot_plan", "")
            sku = resp.get("access_type_sku", "")
            if login:
                status_text = "@" + str(login)
            if sku:
                tier_label = sku.replace("_", " ").title()
            elif plan:
                tier_label = plan.capitalize()

            snapshots = resp.get("quota_snapshots", {})
            reset_date = resp.get("quota_reset_date_utc") or resp.get("quota_reset_date") or ""
            for qid, qinfo in snapshots.items():
                entitlement = qinfo.get("entitlement", 0)
                remaining = qinfo.get("remaining", 0)
                clean_name = qid.replace("_", " ").title()
                if entitlement > 0:
                    pct_rem = round(max(0.0, min(1.0, remaining / entitlement)), 4)
                    limits.append({
                        "label": clean_name + " Remaining",
                        "title": clean_name + " Remaining",
                        "percent": pct_rem,
                        "resetsAt": reset_date
                    })
        except Exception:
            pass

    # 2. Parse sqlite db for session stats
    today_str = dt.date.today().isoformat()
    recent_dates = [(dt.date.today() - dt.timedelta(days=i)).isoformat() for i in range(6, -1, -1)]
    recent_days = {d: 0 for d in recent_dates}
    today_tokens = 0
    today_prompts = 0
    today_sessions = 0
    today_tokens_by_model = {}
    model_usage = {}
    total_prompts = 0
    total_sessions = 0
    active_dates = set()

    if os.path.exists(db_path):
        try:
            conn = sqlite3.connect(db_path)
            cur = conn.cursor()

            # Sessions
            cur.execute("SELECT count(distinct id) FROM sessions;")
            row = cur.fetchone()
            total_sessions = row[0] if row else 0

            # Turns
            cur.execute("SELECT count(*) FROM turns;")
            row = cur.fetchone()
            total_prompts = row[0] if row else 0

            cur.execute("SELECT count(*) FROM turns WHERE date(timestamp) = date('now');")
            row = cur.fetchone()
            today_prompts = row[0] if row else 0

            # Usage events
            cur.execute("SELECT model, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, date(created_at), session_id FROM assistant_usage_events;")
            today_sess_set = set()
            for model, inp, out, cread, cwrite, date_str, sess_id in cur.fetchall():
                inp = inp or 0
                out = out or 0
                cread = cread or 0
                cwrite = cwrite or 0
                total = inp + out + cread + cwrite

                if date_str:
                    active_dates.add(date_str)
                    if date_str in recent_days:
                        recent_days[date_str] += total

                if model not in model_usage:
                    model_usage[model] = {
                        "inputTokens": 0,
                        "outputTokens": 0,
                        "cacheReadInputTokens": 0,
                        "cacheCreationInputTokens": 0
                    }
                model_usage[model]["inputTokens"] += inp
                model_usage[model]["outputTokens"] += out
                model_usage[model]["cacheReadInputTokens"] += cread
                model_usage[model]["cacheCreationInputTokens"] += cwrite

                if date_str == today_str:
                    today_tokens += total
                    today_sess_set.add(sess_id)
                    today_tokens_by_model[model] = today_tokens_by_model.get(model, 0) + total

            today_sessions = len(today_sess_set)
            conn.close()
        except Exception:
            pass

    record = {
        "schemaVersion": 1,
        "id": "copilot",
        "name": "GitHub Copilot",
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": True,
        "tierLabel": tier_label,
        "usageStatusText": status_text,
        "todayPrompts": today_prompts,
        "todaySessions": today_sessions,
        "todayTotalTokens": today_tokens,
        "todayTokensByModel": today_tokens_by_model,
        "totalPrompts": total_prompts,
        "totalSessions": total_sessions,
        "activeDays": len(active_dates),
        "activeDates": sorted(list(active_dates)),
        "recentDays": [{"date": d, "messageCount": recent_days[d]} for d in recent_dates],
        "modelUsage": model_usage,
        "limits": limits
    }
    print(json.dumps(record, indent=2))

if __name__ == "__main__":
    main()
