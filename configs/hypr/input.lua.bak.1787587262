-- App-specific touchpad scroll speeds.
-- o.window("(Alacritty|kitty|foot)", { scroll_touchpad = 1.5 })
-- o.window("com.mitchellh.ghostty", { scroll_touchpad = 0.2 })

-- 4-finger swipe gestures to move windows across monitors:
-- Swipe up moves active window to upper monitor (e.g. Acer / Iiyama)
-- Swipe down moves active window to lower monitor (e.g. laptop)
-- Swipe left moves active window to left monitor (e.g. Acer)
-- Swipe right moves active window to right monitor (e.g. Iiyama)
hl.gesture({ fingers = 4, direction = "up", action = function() hl.dispatch(hl.dsp.window.move({ monitor = "u" })) end })
hl.gesture({ fingers = 4, direction = "down", action = function() hl.dispatch(hl.dsp.window.move({ monitor = "d" })) end })
hl.gesture({ fingers = 4, direction = "left", action = function() hl.dispatch(hl.dsp.window.move({ monitor = "l" })) end })
hl.gesture({ fingers = 4, direction = "right", action = function() hl.dispatch(hl.dsp.window.move({ monitor = "r" })) end })

-- Map laptop touchscreen pen/stylus and finger touch directly to the laptop display (eDP-1)
hl.device({
  name = "wacom-hid-5365-pen",
  output = "eDP-1",
})
hl.device({
  name = "wacom-hid-5365-finger",
  output = "eDP-1",
})

