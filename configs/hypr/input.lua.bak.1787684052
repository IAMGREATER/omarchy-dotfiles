-- 4-finger swipe gestures to move windows across monitors safely:
-- Swipe up moves active window to upper monitor (e.g. Acer / Iiyama)
-- Swipe down moves active window to lower monitor (e.g. laptop)
-- Swipe left moves active window to left monitor (e.g. Acer)
-- Swipe right moves active window to right monitor (e.g. Iiyama)
local function get_monitor_logical_box(m)
  local scale = m.scale or 1.0
  return {
    name = m.name,
    x1 = m.x,
    y1 = m.y,
    x2 = m.x + (m.width / scale),
    y2 = m.y + (m.height / scale),
  }
end

local function safe_move_window_to_monitor(dir)
  pcall(function()
    local win = hl.get_active_window()
    if not win then return end

    local cur_mon = hl.get_active_monitor()
    if not cur_mon then return end

    local cur = get_monitor_logical_box(cur_mon)
    local mons = hl.get_monitors()
    local has_target = false

    for _, m in ipairs(mons) do
      if m.name ~= cur.name then
        local b = get_monitor_logical_box(m)
        local y_overlap = (b.y1 < cur.y2 - 1) and (b.y2 > cur.y1 + 1)
        local x_overlap = (b.x1 < cur.x2 - 1) and (b.x2 > cur.x1 + 1)

        if dir == "u" and b.y2 <= cur.y1 + 1 and x_overlap then
          has_target = true
          break
        elseif dir == "d" and b.y1 >= cur.y2 - 1 and x_overlap then
          has_target = true
          break
        elseif dir == "l" and b.x2 <= cur.x1 + 1 and y_overlap then
          has_target = true
          break
        elseif dir == "r" and b.x1 >= cur.x2 - 1 and y_overlap then
          has_target = true
          break
        end
      end
    end

    if not has_target then return end

    hl.dispatch(hl.dsp.window.move({ monitor = dir }))
  end)
end

hl.gesture({ fingers = 4, direction = "up", action = function() safe_move_window_to_monitor("u") end })
hl.gesture({ fingers = 4, direction = "down", action = function() safe_move_window_to_monitor("d") end })
hl.gesture({ fingers = 4, direction = "left", action = function() safe_move_window_to_monitor("l") end })
hl.gesture({ fingers = 4, direction = "right", action = function() safe_move_window_to_monitor("r") end })

-- Map laptop touchscreen pen/stylus and finger touch directly to the laptop display (eDP-1)
hl.device({
  name = "wacom-hid-5365-pen",
  output = "eDP-1",
})
hl.device({
  name = "wacom-hid-5365-finger",
  output = "eDP-1",
})

