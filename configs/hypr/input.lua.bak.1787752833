-- Keep only your personal input overrides here. Uncommented settings below
-- replace Omarchy's defaults.

-- Keyboard layout and options.
-- See https://wiki.hypr.land/Configuring/Basics/Variables/#input
hl.config({
  input = {
    -- Right Alt is the Compose (emoji/symbol) key; CapsLock functions normally.
    kb_options = "compose:ralt",

    -- Start with numlock on by default.
    numlock_by_default = true,

    -- Increase sensitivity for mouse/trackpad (default: 0).
    sensitivity = 0.35,

    touchpad = {
      -- Use natural (inverse) scrolling.
      natural_scroll = true,

      -- Use two-finger clicks for right-click instead of lower-right corner.
      clickfinger_behavior = true,

      -- Control the speed of your scrolling.
      scroll_factor = 0.4,

      -- Enable the touchpad while typing.
      disable_while_typing = false,
    },
  },
})

-- App-specific touchpad scroll speeds.
-- o.window("(Alacritty|kitty|foot)", { scroll_touchpad = 1.5 })
-- o.window("com.mitchellh.ghostty", { scroll_touchpad = 0.2 })


-- Function to cycle active window across all active monitors
local function cycle_window_monitor(direction)
  pcall(function()
    local win = hl.get_active_window()
    if not win then return end

    local cur_mon = hl.get_active_monitor()
    if not cur_mon then return end

    local raw_mons = hl.get_monitors()
    local mons = {}
    for _, m in ipairs(raw_mons) do
      if not m.disabled then
        table.insert(mons, m)
      end
    end
    if #mons <= 1 then return end

    -- Sort monitors spatially: top-to-bottom, then left-to-right
    table.sort(mons, function(a, b)
      if math.abs(a.y - b.y) > 200 then
        return a.y < b.y
      end
      return a.x < b.x
    end)

    local cur_idx = nil
    for i, m in ipairs(mons) do
      if m.name == cur_mon.name then
        cur_idx = i
        break
      end
    end
    if not cur_idx then return end

    local target_idx
    if direction == "right" then
      target_idx = (cur_idx % #mons) + 1
    else
      target_idx = ((cur_idx - 2 + #mons) % #mons) + 1
    end

    local target = mons[target_idx]
    if target and target.name ~= cur_mon.name then
      hl.dispatch(hl.dsp.window.move({ monitor = target.name }))
    end
  end)
end

-- 4-finger swipe gestures to cycle active window across monitors:
-- Swipe left: Cycles active window to the previous monitor
-- Swipe right: Cycles active window to the next monitor
hl.gesture({
  fingers = 4,
  direction = "left",
  action = function()
    cycle_window_monitor("left")
  end,
})

hl.gesture({
  fingers = 4,
  direction = "right",
  action = function()
    cycle_window_monitor("right")
  end,
})


-- Tablet / Stylus and Cursor configuration to prevent erratic jumping and multi-monitor interference
hl.config({
  cursor = {
    warp_back_after_non_mouse_input = true,
    hide_on_tablet = true,
    hide_on_touch = true,
  },
  input = {
    tablet = {
      output = "eDP-1",
    },
    touchdevice = {
      output = "eDP-1",
    },
  },
})

-- Map laptop touchscreen pen/stylus and finger touch directly to the laptop display (eDP-1)
hl.device({
  name = "wacom-hid-5365-pen",
  output = "eDP-1",
})
hl.device({
  name = "wacom-hid-5365-finger",
  output = "eDP-1",
})


