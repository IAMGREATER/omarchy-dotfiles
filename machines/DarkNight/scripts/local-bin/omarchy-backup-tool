        dialog.set_title("Select Backup Destination Folder")
        dialog.select_folder(self, None, self.on_folder_selected)

    def on_folder_selected(self, dialog, result):
        try:
            folder = dialog.select_folder_finish(result)
            if folder:
                self.custom_path = folder.get_path()
                self.custom_row.set_subtitle(self.custom_path)
        except Exception:
            pass

    # ------------------ BACKUP EXECUTION ------------------
    def on_start_backup(self, btn):
        dest_gh = self.github_switch.get_active()
        dest_vault = self.local_switch.get_active() and os.path.isdir("/run/media/subi/VAULT")
        dest_custom = self.custom_switch.get_active() and bool(self.custom_path)

        if not (dest_gh or dest_vault or dest_custom):
            self.status_label.set_text("⚠️ Please select at least one valid destination.")
            return

        selected_items = [cid for cid, sw in self.switches.items() if sw.get_active()]
        if not selected_items:
            self.status_label.set_text("⚠️ Please select at least one item to backup.")
            return

        self.backup_btn.set_sensitive(False)
        self.progress_bar.set_fraction(0.05)
        self.status_label.set_text("Starting incremental backup...")

        thread = threading.Thread(target=self.run_backup, args=(dest_gh, dest_vault, dest_custom, selected_items))
        thread.daemon = True
        thread.start()

    def update_ui_status(self, text, frac):
        GLib.idle_add(self._apply_status, text, frac)

    def _apply_status(self, text, frac):
        self.status_label.set_text(text)
        self.progress_bar.set_fraction(frac)

    def finish_backup(self, success, msg):
        GLib.idle_add(self._apply_finish, success, msg)

    def _apply_finish(self, success, msg):
        self.backup_btn.set_sensitive(True)
        self.progress_bar.set_fraction(1.0 if success else 0.0)
        self.status_label.set_text(msg)
        self.populate_restore_sources()
        subprocess.run(["notify-send", "-a", "Backup Hub", "Backup Completed" if success else "Backup Failed", msg])

    def run_backup(self, dest_gh, dest_vault, dest_custom, selected_items):
        try:
            date_str = datetime.now().strftime("%d-%m-%Y")
            repo = self.repo_dir
            backup_root = self.machine_root(repo)
            self.ensure_git_repo(repo)
            os.makedirs(backup_root, exist_ok=True)

            total_steps = len(selected_items) + 3
            cur_step = 0

            # Sync chosen items incrementally
            for cat in BACKUP_CATEGORIES:
                cid = cat["id"]
                if cid not in selected_items:
                    continue

                cur_step += 1
                self.update_ui_status(f"Syncing {cat['title']}...", cur_step / total_steps)

                exclude_flags = []
                for ex in cat.get("exclude", []):
                    exclude_flags.extend(["--exclude", ex])

                if "source" in cat:
                    src = cat["source"]
                    dst = os.path.join(backup_root, cat["dest_sub"])
                    if os.path.exists(src):
                        os.makedirs(dst, exist_ok=True)
                        cmd = ["rsync", "-a", "--delete"] + exclude_flags + [f"{src}/", f"{dst}/"]
                        subprocess.run(cmd)

                elif "sources" in cat:
                    for src, sub, _ in cat["sources"]:
                        if os.path.exists(src):
                            dst = os.path.join(backup_root, sub)
                            os.makedirs(dst, exist_ok=True)
                            cmd = ["rsync", "-a", "--delete"] + exclude_flags + [f"{src}/", f"{dst}/"]
                            subprocess.run(cmd)

                elif "files" in cat:
                    for fpath, sub, _ in cat["files"]:
                        if os.path.exists(fpath):
                            dst_file = os.path.join(backup_root, sub)
                            os.makedirs(os.path.dirname(dst_file), exist_ok=True)
                            subprocess.run(["cp", fpath, dst_file])

                elif cat.get("generator"):
                    pkg_dir = os.path.join(backup_root, "packages")
                    os.makedirs(pkg_dir, exist_ok=True)
                    with open(os.path.join(pkg_dir, "pacman-explicit.txt"), "w") as f:
                        subprocess.run(["pacman", "-Qe"], stdout=f)
                    with open(os.path.join(pkg_dir, "aur-packages.txt"), "w") as f:
                        subprocess.run(["pacman", "-Qm"], stdout=f)
                    with open(os.path.join(pkg_dir, "omarchy-plugins.txt"), "w") as f:
                        subprocess.run(["omarchy", "plugin", "list"], stdout=f)
                    res = subprocess.run(["omarchy", "plugin", "list"], capture_output=True, text=True)
                    third_party = []
                    for line in res.stdout.splitlines()[1:]:
                        parts = line.split()
                        if len(parts) >= 3 and parts[1] == "enabled" and parts[2] == "third-party":
                            third_party.append(parts[0])
                    with open(os.path.join(pkg_dir, "omarchy-third-party-enabled.txt"), "w") as f:
                        f.write("\n".join(third_party) + "\n")
                    mise_cfg = os.path.expanduser("~/.config/mise/config.toml")
                    if os.path.isfile(mise_cfg):
                        subprocess.run(["cp", mise_cfg, os.path.join(pkg_dir, "mise-tools.toml")])

            # Cleanup any bulky temp/cache files from scripts/local-bin in repo
            bin_target = os.path.join(backup_root, "scripts/local-bin")
            if os.path.isdir(bin_target):
                subprocess.run(["find", bin_target, "-name", "*.bak*", "-delete"])
                subprocess.run(["find", bin_target, "-name", "__pycache__", "-exec", "rm", "-rf", "{}", "+"])
                subprocess.run(["rm", "-f", os.path.join(bin_target, "agy")])

            # Push to GitHub
            gh_msg = ""
            if dest_gh:
                cur_step += 1
                self.update_ui_status("Committing and pushing changes to GitHub...", cur_step / total_steps)
                subprocess.run(["git", "-C", repo, "add", "-A"])
                diff = subprocess.run(["git", "-C", repo, "diff", "--cached", "--quiet"])
                if diff.returncode != 0:
                    subprocess.run(["git", "-C", repo, "commit", "-m", f"Backup update {date_str}"])
                    push_res = subprocess.run(
                        self.git_command(repo, "push", "origin", "main"),
                        capture_output=True,
                        text=True,
                    )
                    if push_res.returncode == 0:
                        gh_msg = " • Pushed latest changes to GitHub"
                    else:
                        gh_msg = f" • GitHub warning: {push_res.stderr.strip()[:60]}"
                else:
                    gh_msg = " • GitHub already up to date (no changes)"

            # Sync to VAULT under main Omarchy Backup folder
            vault_msg = ""
            if dest_vault:
                cur_step += 1
                self.update_ui_status("Syncing to VAULT external drive...", cur_step / total_steps)
                os.makedirs(self.vault_base, exist_ok=True)
                vault_target = os.path.join(
                    self.vault_base, self.machine_name, f"Backup {date_str}"
                )
                os.makedirs(vault_target, exist_ok=True)
                subprocess.run(["rsync", "-a", "--delete", f"{repo}/", f"{vault_target}/"])
                vault_msg = f" • Synced to VAULT ({vault_target})"

            # Sync to Custom folder
            custom_msg = ""
            if dest_custom and self.custom_path:
                cur_step += 1
                self.update_ui_status(f"Syncing to {self.custom_path}...", cur_step / total_steps)
                custom_target = os.path.join(
                    self.custom_path, self.machine_name, f"Backup {date_str}"
                )
                os.makedirs(custom_target, exist_ok=True)
                subprocess.run(["rsync", "-a", "--delete", f"{repo}/", f"{custom_target}/"])
                custom_msg = f" • Synced to {custom_target}"

            final_msg = f"✅ Backup complete!\n{gh_msg}\n{vault_msg}\n{custom_msg}".strip()
            self.finish_backup(True, final_msg)

        except Exception as e:
            self.finish_backup(False, f"❌ Backup error: {str(e)}")

    # ------------------ RESTORE EXECUTION ------------------
    def on_start_restore(self, btn):
        idx = self.source_row.get_selected()
        if idx < 0 or idx >= len(self.source_paths):
            self.restore_status_label.set_text("⚠️ Invalid restore source selected.")
            return

        source_dir = self.source_paths[idx]
        selected_items = [cid for cid, sw in self.restore_switches.items() if sw.get_active()]

        if not selected_items:
            self.restore_status_label.set_text("⚠️ Please select at least one item to restore.")
            return

        self.restore_btn.set_sensitive(False)
        self.restore_progress_bar.set_fraction(0.05)
        self.restore_status_label.set_text("Starting restore...")

        thread = threading.Thread(target=self.run_restore, args=(source_dir, selected_items))
        thread.daemon = True
        thread.start()

    def update_restore_status(self, text, frac):
        GLib.idle_add(self._apply_restore_status, text, frac)

    def _apply_restore_status(self, text, frac):
        self.restore_status_label.set_text(text)
        self.restore_progress_bar.set_fraction(frac)

    def finish_restore(self, success, msg):
        GLib.idle_add(self._apply_restore_finish, success, msg)

    def _apply_restore_finish(self, success, msg):
        self.restore_btn.set_sensitive(True)
        self.restore_progress_bar.set_fraction(1.0 if success else 0.0)
        self.restore_status_label.set_text(msg)
        subprocess.run(["notify-send", "-a", "Backup Hub", "Restore Completed" if success else "Restore Failed", msg])

    def run_restore(self, source_dir, selected_items):
        try:
            # If source is git repo, ensure it's pulled first
            if source_dir == self.machine_root(self.repo_dir):
                self.update_restore_status("Pulling latest commits from GitHub...", 0.05)
                subprocess.run(
                    self.git_command(self.repo_dir, "pull", "origin", "main"),
                    capture_output=True,
                    text=True,
                )

            total_steps = len(selected_items) + 2
            cur_step = 0

            for cat in BACKUP_CATEGORIES:
                cid = cat["id"]
                if cid not in selected_items:
                    continue

                cur_step += 1
                self.update_restore_status(f"Restoring {cat['title']}...", cur_step / total_steps)

                if "source" in cat:
                    src = os.path.join(source_dir, cat["dest_sub"])
                    dst = cat["restore_dest"]
                    if os.path.exists(src):
                        os.makedirs(dst, exist_ok=True)
                        subprocess.run(["rsync", "-a", f"{src}/", f"{dst}/"])

                elif "sources" in cat:
                    for _, sub, r_dst in cat["sources"]:
                        src = os.path.join(source_dir, sub)
                        if os.path.exists(src):
                            os.makedirs(r_dst, exist_ok=True)
                            subprocess.run(["rsync", "-a", f"{src}/", f"{r_dst}/"])

                elif "files" in cat:
                    for _, sub, r_dst in cat["files"]:
                        src_file = os.path.join(source_dir, sub)
                        if os.path.isfile(src_file):
                            os.makedirs(os.path.dirname(r_dst), exist_ok=True)
                            subprocess.run(["cp", src_file, r_dst])

                elif cat.get("generator"):
                    # Re-enable plugins
                    enabled_txt = os.path.join(source_dir, "packages/omarchy-third-party-enabled.txt")
                    if os.path.isfile(enabled_txt):
                        with open(enabled_txt) as f:
                            for line in f:
                                plugin_id = line.strip()
                                if plugin_id:
                                    subprocess.run(["omarchy", "plugin", "add", plugin_id, "--enable"], capture_output=True)
                                    subprocess.run(["omarchy", "plugin", "enable", plugin_id], capture_output=True)

            # Reload daemons and keybindings
            cur_step += 1
            self.update_restore_status("Reloading system services & window manager...", cur_step / total_steps)
            subprocess.run(["systemctl", "--user", "daemon-reload"])
            subprocess.run(["systemctl", "--user", "restart", "weazystroke.service"], capture_output=True)
            subprocess.run(["hyprctl", "reload"], capture_output=True)

            self.finish_restore(True, f"✅ Selected items restored successfully from:\n{source_dir}")

        except Exception as e:
            self.finish_restore(False, f"❌ Restore error: {str(e)}")

if __name__ == "__main__":
    app = BackupApp()
    sys.exit(app.run(sys.argv))
