    def set_all_switches(self, switch_dict, state):
        for sw in switch_dict.values():
            sw.set_active(state)

    def populate_restore_sources(self):
        while self.source_model.get_n_items() > 0:
            self.source_model.remove(0)

        self.source_paths = []

        # 1. GitHub dotfiles clone
        machine_source = self.machine_root(self.repo_dir)
        if os.path.isdir(machine_source):
            self.source_model.append(f"GitHub: {self.machine_name}")
            self.source_paths.append(machine_source)
        else:
            self.source_model.append("GitHub Repository (legacy root)")
            self.source_paths.append(self.repo_dir)

        # 2. VAULT backups
        if os.path.isdir(self.vault_base):
            entries = sorted(
                glob.glob(os.path.join(self.vault_base, self.machine_name, "Backup *")),
                reverse=True,
            )
            for entry in entries:
                name = os.path.basename(entry)
                self.source_model.append(f"VAULT ({self.machine_name}): {name}")
                self.source_paths.append(entry)
            # Keep older date-only snapshots available for restore.
            legacy_entries = sorted(glob.glob(os.path.join(self.vault_base, "Backup *")), reverse=True)
            for entry in legacy_entries:
                name = os.path.basename(entry)
                self.source_model.append(f"VAULT (legacy): {name}")
                self.source_paths.append(entry)

        if self.source_model.get_n_items() > 0:
            self.source_row.set_selected(0)
            self.on_restore_source_changed(self.source_row, None)

    def on_restore_source_changed(self, row, param):
        idx = row.get_selected()
        if 0 <= idx < len(self.source_paths):
            src = self.source_paths[idx]
            self.restore_status_label.set_text(f"Selected source: {src}")

    def on_custom_toggle(self, sw, param):
        active = sw.get_active()
        self.custom_choose_btn.set_sensitive(active)
        if not active:
            self.custom_row.set_subtitle("Disabled")
        elif self.custom_path:
            self.custom_row.set_subtitle(self.custom_path)
        else:
            self.custom_row.set_subtitle("Select a target directory...")

