    def save_git_settings(self, _button):
        self.git_username = self.git_username_entry.get_text().strip()
        self.git_pat = self.git_pat_entry.get_text()
        self.machine_name = re.sub(r"[^A-Za-z0-9._-]+", "-", self.machine_name_entry.get_text().strip()).strip("-")
        if not self.machine_name:
            self.settings_status.set_text("Enter a machine name first.")
            return
        try:
            os.makedirs(os.path.dirname(self.settings_path), mode=0o700, exist_ok=True)
            with open(self.settings_path, "w") as f:
                json.dump(
                    {
                        "git_username": self.git_username,
                        "git_pat": self.git_pat,
                        "machine_name": self.machine_name,
                    },
                    f,
                )
            os.chmod(self.settings_path, stat.S_IRUSR | stat.S_IWUSR)
            self.settings_status.set_text("GitHub credentials saved.")
        except OSError as e:
            self.settings_status.set_text(f"Could not save credentials: {e}")

    def test_git_settings(self, _button):
        username = self.git_username_entry.get_text().strip()
        pat = self.git_pat_entry.get_text()
        if not username or not pat:
            self.settings_status.set_text("Enter both a GitHub username and PAT first.")
            return

        self.settings_status.set_text("Testing GitHub credentials...")

        def run_test():
            token = base64.b64encode(f"{username}:{pat}".encode()).decode()
            command = [
                "git",
                "-c",
                f"http.extraHeader=Authorization: Basic {token}",
                "ls-remote",
                "https://github.com/IAMGREATER/omarchy-dotfiles.git",
                "HEAD",
            ]
            try:
                result = subprocess.run(
                    command,
                    capture_output=True,
                    text=True,
                    timeout=20,
                )
                if result.returncode == 0:
                    message = "GitHub credentials work."
                else:
                    message = f"GitHub test failed: {result.stderr.strip()[:180]}"
            except (OSError, subprocess.TimeoutExpired) as e:
                message = f"GitHub test failed: {e}"
            GLib.idle_add(self.settings_status.set_text, message)

        thread = threading.Thread(target=run_test, daemon=True)
        thread.start()

    def git_command(self, repo, *args):
        command = ["git", "-C", repo]
        if self.git_username and self.git_pat:
            token = base64.b64encode(
                f"{self.git_username}:{self.git_pat}".encode()
            ).decode()
            command.extend(["-c", f"http.extraHeader=Authorization: Basic {token}"])
        command.extend(args)
        return command

    def machine_root(self, repo):
        return os.path.join(repo, "machines", self.machine_name)

    def ensure_git_repo(self, repo):
        os.makedirs(repo, exist_ok=True)
        if os.path.isdir(os.path.join(repo, ".git")):
            return

        result = subprocess.run(
            self.git_command(repo, "init", "-b", "main"),
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"Could not initialize Git repository: {result.stderr.strip()}")

        remote = "https://github.com/IAMGREATER/omarchy-dotfiles.git"
        result = subprocess.run(
            self.git_command(repo, "remote", "add", "origin", remote),
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"Could not configure Git remote: {result.stderr.strip()}")

        result = subprocess.run(
            self.git_command(repo, "fetch", "origin", "main"),
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"Could not fetch GitHub repository: {result.stderr.strip()}")

        result = subprocess.run(
            self.git_command(repo, "checkout", "-b", "main", "--track", "origin/main"),
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"Could not check out GitHub repository: {result.stderr.strip()}")

