#!/usr/bin/env python3
"""
Git credential helper for Omarchy Backup Hub.
Reads GitHub username/token from the system keyring (libsecret).
Usage: git config credential.helper '/path/to/git-credential-omarchy'
"""
import sys
import subprocess
import os

KEYRING_ATTR_USERNAME = "omarchy-github-username"
KEYRING_ATTR_TOKEN    = "omarchy-github-token"


def keyring_get(attribute):
    try:
        result = subprocess.run(
            ["secret-tool", "lookup", "application", attribute],
            capture_output=True, text=True
        )
        return result.stdout.strip() if result.returncode == 0 else ""
    except Exception:
        return ""


def main():
    if len(sys.argv) < 2:
        sys.exit(0)

    action = sys.argv[1]

    if action == "get":
        username = keyring_get(KEYRING_ATTR_USERNAME)
        token    = keyring_get(KEYRING_ATTR_TOKEN)
        if username and token:
            sys.stdout.write(f"username={username}\npassword={token}\n")
        sys.stdout.flush()

    elif action == "store":
        # We manage storage ourselves via the UI; ignore store requests
        pass

    elif action == "erase":
        # We manage erasure via the UI; ignore erase requests
        pass


if __name__ == "__main__":
    main()
